# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor: la usa el cron de sincronización. Nunca exponer en el cliente.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Sigma (cuenta de servicio con permiso Api_Sigma) ---
SIGMA_HOST=sigma.sig2k.com
SIGMA_ID_CLIENTE=quomkt@sigma
SIGMA_TOKEN=
# Identifica a esta app ante Sigma (idempotencia id + deviceId)
SIGMA_DEVICE_ID=QUO-PRESUPUESTOS
# Datos de facturación (ver ExportEmpresas, ExportPuntosDeVenta, ExportCodigosComprobanteFacturas)
SIGMA_EMPRESA=0001
SIGMA_PUNTO_DE_VENTA=1
SIGMA_LETRA_COMPROBANTE=A
SIGMA_CODIGO_COMPROBANTE=FA
# Artículo de servicio en Sigma con el que se factura el presupuesto
SIGMA_ARTICULO_SERVICIO=
# Opcional: código AFIP del comprobante (01 = Factura A)
SIGMA_AFIP_CODIGO_COMPROBANTE=01

# --- Connecteam (Settings → API Keys) ---
CONNECTEAM_API_KEY=
CONNECTEAM_BASE_URL=https://api.connecteam.com

# --- Vercel Cron: Vercel envía "Authorization: Bearer $CRON_SECRET" ---
CRON_SECRET=
